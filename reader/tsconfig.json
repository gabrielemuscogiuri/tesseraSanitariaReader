{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-main",
    "rootDir": "src",
    "paths": {
      "tessera-sanitaria-reader": ["../dist/index.d.ts"],
      "tessera-sanitaria-reader/client": ["../dist/client.d.ts"]
    }
  },
  "include": ["src/main.ts", "src/preload.ts"]
}
