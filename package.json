{
  "name": "tessera-sanitaria-reader",
  "version": "1.1.1",
  "description": "Read Italian tessera sanitaria (TS-CNS) personal data via PC/SC",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "bin": {
    "tessera-sanitaria-reader": "./dist/cli.js",
    "tessera-sanitaria-agent": "./dist/agent.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0 && prettier --check .",
    "lint:fix": "eslint src test --fix --max-warnings 0 && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm lint && pnpm build",
    "prepare": "tsup"
  },
  "keywords": [
    "tessera sanitaria",
    "ts-cns",
    "smartcard",
    "pcsc",
    "italy",
    "codice fiscale"
  ],
  "license": "MIT",
  "author": "Gabriele Muscogiuri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielemuscogiuri/tesseraSanitariaReader.git"
  },
  "homepage": "https://github.com/gabrielemuscogiuri/tesseraSanitariaReader#readme",
  "bugs": {
    "url": "https://github.com/gabrielemuscogiuri/tesseraSanitariaReader/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "pcsclite": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.23.12",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
